@app.post("/api/jobs")
async def create_job(
    image: UploadFile = File(...),
    seed: int = Form(5),
    steps: int = Form(150),
    cfg: float = Form(1.3),
    crop: float = Form(2.8),
    upsample: int = Form(3),
    decode_chunks: int = Form(10),
    strand_subsample: float = Form(1.0),
    vertex_subsample: float = Form(0.5),
    radius: float = Form(0.0001),
    preview_resolution: int = Form(900),
):
    if steps < 25 or steps > 400:
        raise HTTPException(400, "steps must be between 25 and 400")
    if cfg < 0.1 or cfg > 4.0:
        raise HTTPException(400, "cfg must be between 0.1 and 4.0")
    if crop < 1.8 or crop > 4.0:
        raise HTTPException(400, "crop must be between 1.8 and 4.0")
    if upsample < 1 or upsample > 8:
        raise HTTPException(400, "upsample must be between 1 and 8")
    if decode_chunks < 5 or decode_chunks > 100:
        raise HTTPException(400, "decode_chunks must be between 5 and 100")
    if not (0.05 <= strand_subsample <= 1.0):
        raise HTTPException(400, "strand_subsample must be between 0.05 and 1.0")
    if not (0.125 <= vertex_subsample <= 1.0):
        raise HTTPException(400, "vertex_subsample must be between 0.125 and 1.0")
    if radius <= 0 or radius > 0.01:
        raise HTTPException(400, "radius must be > 0 and <= 0.01")
    if preview_resolution < 400 or preview_resolution > 1600:
        raise HTTPException(400, "preview_resolution must be between 400 and 1600")

    job_id = uuid.uuid4().hex[:12]
    root = job_dir(job_id)
    root.mkdir(parents=True, exist_ok=True)
    input_path = root / "input.png"
    original_path = root / "upload.bin"

    raw = await image.read()
    source_md5 = hashlib.md5(raw).hexdigest()
    original_path.write_bytes(raw)
    try:
        with Image.open(original_path) as img:
            img = ImageOps.exif_transpose(img).convert("RGB")
            img.save(input_path)
    except Exception as exc:
        shutil.rmtree(root, ignore_errors=True)
        raise HTTPException(400, f"Could not read image: {exc}")
    image_md5 = file_md5(input_path)

    params = normalize_job_params(
        {
            "seed": seed,
            "steps": steps,
            "cfg": cfg,
            "crop": crop,
            "upsample": upsample,
            "decode_chunks": decode_chunks,
            "strand_subsample": strand_subsample,
            "vertex_subsample": vertex_subsample,
            "radius": radius,
            "preview_resolution": preview_resolution,
        }
    )
    reusable = find_reusable_job({source_md5, image_md5}, params)
    if reusable is not None:
        shutil.rmtree(root, ignore_errors=True)
        decorated = decorate_job(reusable)
        reused_status = str(reusable.get("status") or "")
        return {
            "id": reusable["id"],
            "status_url": f"/api/jobs/{reusable['id']}",
            "cache_hit": reused_status == "done",
            "reused": True,
            "reused_status": reused_status,
            "queue_position": decorated.get("queue_position"),
            "jobs_ahead": decorated.get("jobs_ahead"),
            "queued_count": decorated.get("queued_count"),
            "running_count": decorated.get("running_count"),
        }

    job = {
        "id": job_id,
        "status": "queued",
        "stage": "queued",
        "created_at": now_ts(),
        "updated_at": now_ts(),
        "filename": image.filename,
        "source_md5": source_md5,
        "image_md5": image_md5,
        "cache_key": params_cache_key(params),
        "params": params,
    }
    with jobs_lock:
        jobs[job_id] = job
        write_json(status_path(job_id), job)
    job_queue.put(job_id)
    decorated = decorate_job(job)
    return {
        "id": job_id,
        "status_url": f"/api/jobs/{job_id}",
        "cache_hit": False,
        "reused": False,
        "queue_position": decorated.get("queue_position"),
        "jobs_ahead": decorated.get("jobs_ahead"),
        "queued_count": decorated.get("queued_count"),
        "running_count": decorated.get("running_count"),
    }


