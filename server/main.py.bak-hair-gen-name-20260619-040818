def job_md5_values(job: dict[str, Any]) -> set[str]:
    values = {
        str(job.get("source_md5") or "").lower(),
        str(job.get("upload_md5") or "").lower(),
        str(job.get("image_md5") or "").lower(),
    }
    job_id = str(job.get("id") or "")
    if job_id:
        root = job_dir(job_id)
        for name in ("upload.bin", "input.png"):
            path = root / name
            if path.exists() and path.is_file():
                try:
                    values.add(file_md5(path).lower())
                except Exception:
                    pass
    values.discard("")
    return values


def job_outputs_available(job: dict[str, Any]) -> bool:
    if job.get("status") != "done":
        return False
    job_id = str(job.get("id") or "")
    if not job_id:
        return False
    return (job_dir(job_id) / "result.blend").exists()


def find_reusable_job(md5_values: set[str], params: dict[str, Any]) -> dict[str, Any] | None:
    target_params_key = params_cache_key(params)
    if not md5_values or not target_params_key:
        return None
    with jobs_lock:
        candidates = [dict(item) for item in jobs.values()]

    def priority(job: dict[str, Any]) -> tuple[int, float]:
        status_rank = {"done": 0, "running": 1, "queued": 2}.get(str(job.get("status")), 9)
        return (status_rank, -float(job.get("updated_at") or job.get("created_at") or 0))

    for job in sorted(candidates, key=priority):
        status = str(job.get("status") or "")
        if status not in {"done", "running", "queued"}:
            continue
        if status == "done" and not job_outputs_available(job):
            continue
        if params_cache_key(job.get("params") or {}) != target_params_key:
            continue
        if md5_values & job_md5_values(job):
            return job
    return None


def load_jobs() -> None:
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    with jobs_lock:
        jobs.clear()
        for path in JOBS_DIR.glob("*/status.json"):
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                jobs[data["id"]] = data
            except Exception:
                continue


def update_job(job_id: str, **changes: Any) -> dict[str, Any]:
    with jobs_lock:
        job = jobs[job_id]
        job.update(changes)
        job["updated_at"] = now_ts()
        write_json(status_path(job_id), job)
        return dict(job)


def decorate_job(job: dict[str, Any]) -> dict[str, Any]:
    data = dict(job)
    stage = data.get("stage", "queued")
    status = data.get("status", "queued")
    data.update(queue_snapshot(str(data.get("id") or "")))
    if status == "queued":
        jobs_ahead = int(data.get("jobs_ahead") or 0)
        if jobs_ahead > 0:
            data["stage_label"] = f"排队中 · 前面还有 {jobs_ahead} 个任务"
        else:
            data["stage_label"] = "排队中 · 即将开始"
    else:
        data["stage_label"] = data.get("stage_detail") or STAGE_LABELS.get(stage, stage.replace("_", " "))
    data["progress"] = data.get("progress", STAGE_PROGRESS.get(stage, 0))
    if status == "failed":
        data["progress"] = 100
    data["stages"] = [
        {
            "id": stage_id,
            "label": label,
            "state": stage_state(stage_id, stage, status),
        }
        for stage_id, label in STAGES
    ]
    return data


def stage_state(stage_id: str, current_stage: str, status: str) -> str:
    if status == "failed":
        if stage_id == current_stage:
            return "failed"
        current_index = stage_index(current_stage)
        return "done" if stage_index(stage_id) < current_index else "pending"
    if stage_id == current_stage:
        return "active" if status in ("queued", "running") else status
    if stage_index(stage_id) < stage_index(current_stage):
        return "done"
    return "pending"


def stage_index(stage_id: str) -> int:
    for index, (known_id, _) in enumerate(STAGES):
        if known_id == stage_id:
            return index
    return 0


def tail_text(path: Path, max_bytes: int = 12000) -> str:
    if not path.exists():
        return ""
    size = path.stat().st_size
    with path.open("rb") as f:
        if size > max_bytes:
            f.seek(size - max_bytes)
        data = f.read()
    return data.decode("utf-8", errors="replace")


