def require_auth(request: Request) -> None:
    if PUBLIC_ACCESS:
        return
    if not WEB_PASSWORD:
        return
    auth = request.headers.get("authorization", "")
    expected = "Basic " + base64.b64encode(f"admin:{WEB_PASSWORD}".encode()).decode()
    if not secrets.compare_digest(auth, expected):
        raise HTTPException(
            status_code=401,
            detail="Authentication required",
            headers={"WWW-Authenticate": 'Basic realm="DiffLocks"'},
        )


@app.middleware("http")
async def basic_auth_middleware(request: Request, call_next):
    if request.url.path != "/healthz":
        try:
            require_auth(request)
        except HTTPException as exc:
            return JSONResponse(
                {"detail": exc.detail},
                status_code=exc.status_code,
                headers=exc.headers,
            )
    return await call_next(request)


def run_logged(
    job_id: str,
    cmd: list[str],
    cwd: Path | None = None,
    progress_parser=None,
) -> None:
    log_path = job_dir(job_id) / "job.log"
    last_progress = None
    with log_path.open("a", encoding="utf-8", errors="replace") as log:
        log.write("\n$ " + " ".join(cmd) + "\n")
        log.flush()
        proc = subprocess.Popen(
            cmd,
            cwd=str(cwd) if cwd else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            env={**os.environ, "PYTHONUNBUFFERED": "1"},
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            log.write(line)
            log.flush()
            if progress_parser is not None:
                parsed = progress_parser(line)
                if parsed is not None:
                    progress, detail = parsed
                    progress = int(max(0, min(100, progress)))
                    if progress != last_progress:
                        update_job(job_id, progress=progress, stage_detail=detail)
                        last_progress = progress
        rc = proc.wait()
        log.write(f"\n[exit {rc}]\n")
        log.flush()
    if rc != 0:
        raise RuntimeError(f"Command failed with exit code {rc}: {' '.join(cmd)}")


class ProgressLogStream:
    def __init__(self, job_id: str, log, progress_parser=None):
        self.job_id = job_id
        self.log = log
        self.progress_parser = progress_parser
        self.buffer = ""
        self.last_progress = None

    def write(self, text: str) -> int:
        if not text:
            return 0
        if "cfg_val_cur" not in text:
            self.log.write(text)
            self.log.flush()
        if self.progress_parser is not None:
            self.buffer = (self.buffer + text)[-4000:]
            parsed = self.progress_parser(self.buffer)
            if parsed is not None:
                progress, detail = parsed
                progress = int(max(0, min(100, progress)))
                if progress != self.last_progress:
                    update_job(self.job_id, progress=progress, stage_detail=detail)
                    self.last_progress = progress
        return len(text)

    def flush(self) -> None:
        self.log.flush()


def run_callable_logged(job_id: str, label: str, func, progress_parser=None):
    log_path = job_dir(job_id) / "job.log"
    with log_path.open("a", encoding="utf-8", errors="replace") as log:
        log.write(f"\n$ {label}\n")
        log.flush()
        stream = ProgressLogStream(job_id, log, progress_parser)
        try:
            with contextlib.redirect_stdout(stream), contextlib.redirect_stderr(stream):
                result = func()
        except Exception:
            traceback.print_exc(file=log)
            log.write("\n[exit 1]\n")
            log.flush()
            raise
        log.write("\n[exit 0]\n")
        log.flush()
    return result


def parse_difflocks_progress(line: str):
    matches = list(DIFFLOCKS_PROGRESS_RE.finditer(line))
    if not matches:
        return None
    local_percent = max(0, min(100, int(matches[-1].group(1))))
    overall = 5 + round(local_percent * 0.65)
    return overall, f"正在生成 {local_percent}%"


def composite_photo_front(photo_path: Path, hair_alpha_path: Path, out_path: Path) -> None:
    if not photo_path.exists() or not hair_alpha_path.exists():
        return
    with Image.open(photo_path) as photo_img, Image.open(hair_alpha_path) as hair_img:
        hair = hair_img.convert("RGBA")
        photo = ImageOps.exif_transpose(photo_img).convert("RGBA")
        photo = ImageOps.fit(photo, hair.size, method=Image.Resampling.LANCZOS)
        composed = Image.alpha_composite(photo, hair)
        composed.convert("RGB").save(out_path, quality=95)


def color_to_hex(red: float, green: float, blue: float) -> str:
    return f"#{round(max(0, min(255, red))):02x}{round(max(0, min(255, green))):02x}{round(max(0, min(255, blue))):02x}"


def weighted_average_color(samples: list[tuple[float, int, int, int, float]]) -> tuple[float, float, float]:
    total = sum(score for score, _, _, _, _ in samples)
    if total <= 0:
        return (58.0, 42.0, 33.0)
    red = sum(score * value for score, value, _, _, _ in samples) / total
    green = sum(score * value for score, _, value, _, _ in samples) / total
    blue = sum(score * value for score, _, _, value, _ in samples) / total
    return red, green, blue


def lift_very_dark_color(red: float, green: float, blue: float) -> tuple[float, float, float]:
    luma = 0.2126 * red + 0.7152 * green + 0.0722 * blue
    if luma < 38:
        lift = (38 - luma) * 0.42
        red += lift
        green += lift
        blue += lift
    return red, green, blue


def extract_hair_color_samples(photo_path: Path) -> list[tuple[float, int, int, int, float]]:
    try:
        with Image.open(photo_path) as img:
            img = ImageOps.exif_transpose(img).convert("RGB")
            img.thumbnail((220, 220), Image.Resampling.LANCZOS)
            width, height = img.size
            pixels = img.load()
            samples = []
            for y in range(int(height * 0.02), int(height * 0.66)):
                yn = y / max(height, 1)
                for x in range(int(width * 0.06), int(width * 0.94)):
                    xn = x / max(width, 1)
                    in_top = yn < 0.34 and 0.12 < xn < 0.88
                    in_side = yn < 0.64 and (0.08 < xn < 0.34 or 0.66 < xn < 0.92)
                    in_crown = ((xn - 0.5) / 0.38) ** 2 + ((yn - 0.25) / 0.23) ** 2 < 1
                    if not (in_top or in_side or in_crown):
                        continue

                    red, green, blue = pixels[x, y]
                    luma = 0.2126 * red + 0.7152 * green + 0.0722 * blue
                    max_channel = max(red, green, blue)
                    min_channel = min(red, green, blue)
                    saturation = 0 if max_channel == 0 else (max_channel - min_channel) / max_channel
                    if luma > 246:
                        continue
                    if saturation < 0.045 and luma > 145:
                        continue
                    if luma > 232 and saturation < 0.16:
                        continue

                    hue, _, _ = colorsys.rgb_to_hsv(red / 255, green / 255, blue / 255)
                    skin_like = (
                        0.015 <= hue <= 0.13
                        and saturation > 0.12
                        and red > green > blue
                        and luma > 120
                    )
                    prior = 1.0
                    if in_crown:
                        prior += 0.45
                    if in_top:
                        prior += 0.35
                    if in_side:
                        prior += 0.2
                    darkness = max(0, (238 - luma) / 238)
                    score = prior * (0.35 + darkness * 0.9 + min(saturation, 0.65) * 0.55)
                    if skin_like and yn > 0.34 and 0.34 < xn < 0.66:
                        score *= 0.35
                    samples.append((score, red, green, blue, luma))
        samples.sort(reverse=True, key=lambda item: item[0])
        return samples[: max(160, min(len(samples), len(samples) // 3))]
    except Exception:
        return []


def estimate_hair_palette(photo_path: Path) -> dict[str, str]:
    fallback = {"shadow": "#241812", "base": "#3a2a21", "highlight": "#6d5140"}
    samples = extract_hair_color_samples(photo_path)
    if not samples:
        return dict(fallback)

    by_luma = sorted(samples, key=lambda item: item[4])
    count = len(by_luma)
    shadow = by_luma[: max(24, count // 4)]
    base = by_luma[max(0, count // 4) : max(count // 4 + 1, int(count * 0.72))]
    highlight = by_luma[int(count * 0.68) :]
    if not base:
        base = samples
    if not highlight:
        highlight = base

    shadow_rgb = lift_very_dark_color(*weighted_average_color(shadow))
    base_rgb = lift_very_dark_color(*weighted_average_color(base))
    highlight_rgb = weighted_average_color(highlight)

    base_luma = 0.2126 * base_rgb[0] + 0.7152 * base_rgb[1] + 0.0722 * base_rgb[2]
    highlight_luma = 0.2126 * highlight_rgb[0] + 0.7152 * highlight_rgb[1] + 0.0722 * highlight_rgb[2]
    if highlight_luma < base_luma + 18:
        highlight_rgb = tuple(value * 0.78 + 255 * 0.22 for value in base_rgb)

    return {
        "shadow": color_to_hex(*shadow_rgb),
        "base": color_to_hex(*base_rgb),
        "highlight": color_to_hex(*highlight_rgb),
    }


def estimate_hair_color(photo_path: Path) -> str:
    return estimate_hair_palette(photo_path).get("base", "#3a2a21")


def parse_hex_rgb(value: str) -> tuple[float, float, float]:
    text = (value or "").strip().lstrip("#")
    if len(text) != 6:
        return (58.0, 42.0, 33.0)
    try:
        return (float(int(text[0:2], 16)), float(int(text[2:4], 16)), float(int(text[4:6], 16)))
    except ValueError:
        return (58.0, 42.0, 33.0)


def mix_rgb(left: tuple[float, float, float], right: tuple[float, float, float], amount: float) -> tuple[float, float, float]:
    amount = max(0.0, min(1.0, amount))
    return tuple(left[index] * (1.0 - amount) + right[index] * amount for index in range(3))


def palette_rgb_at(shadow: tuple[float, float, float], base: tuple[float, float, float], highlight: tuple[float, float, float], amount: float) -> tuple[float, float, float]:
    amount = max(0.0, min(1.0, amount))
    if amount < 0.55:
        return mix_rgb(shadow, base, amount / 0.55)
    return mix_rgb(base, highlight, (amount - 0.55) / 0.45)


def recolor_hair_previews(preview_dir: Path, hair_palette: dict[str, str]) -> None:
    shadow = parse_hex_rgb(hair_palette.get("shadow", ""))
    base = parse_hex_rgb(hair_palette.get("base", ""))
    highlight = parse_hex_rgb(hair_palette.get("highlight", ""))

    for view in ("front", "right", "back", "left"):
        preview_path = preview_dir / f"{view}.png"
        alpha_path = preview_dir / f"hair_{view}_alpha.png"
        if not preview_path.exists() or not alpha_path.exists():
            continue
        with Image.open(preview_path) as preview_img, Image.open(alpha_path) as alpha_img:
            preview = preview_img.convert("RGBA")
            alpha = alpha_img.convert("RGBA")
            if alpha.size != preview.size:
                alpha = alpha.resize(preview.size, Image.Resampling.LANCZOS)
            preview_pixels = preview.load()
            alpha_pixels = alpha.load()
            width, height = preview.size
            for y in range(height):
                for x in range(width):
                    hair_red, hair_green, hair_blue, hair_alpha = alpha_pixels[x, y]
                    if hair_alpha <= 2:
                        continue
                    hair_luma = 0.2126 * hair_red + 0.7152 * hair_green + 0.0722 * hair_blue
                    tone = max(0.0, min(1.0, (hair_luma - 14.0) / 176.0))
                    target = palette_rgb_at(shadow, base, highlight, tone)
                    old_red, old_green, old_blue, old_alpha = preview_pixels[x, y]
                    old_luma = 0.2126 * old_red + 0.7152 * old_green + 0.0722 * old_blue
                    target_luma = max(1.0, 0.2126 * target[0] + 0.7152 * target[1] + 0.0722 * target[2])
                    luma_scale = max(0.18, min(2.55, old_luma / target_luma))
                    colored = tuple(max(0, min(255, channel * luma_scale)) for channel in target)
                    coverage = hair_alpha / 255.0
                    strength = min(0.58, (coverage ** 0.68) * 0.64)
                    if max(old_red, old_green, old_blue) - min(old_red, old_green, old_blue) < 10 and coverage > 0.34:
                        strength = min(0.64, strength + 0.08)
                    if old_luma > 165 or hair_luma > 160:
                        strength *= 0.48
                    if old_luma > 218:
                        strength *= 0.25
                    new_red = old_red * (1.0 - strength) + colored[0] * strength
                    new_green = old_green * (1.0 - strength) + colored[1] * strength
                    new_blue = old_blue * (1.0 - strength) + colored[2] * strength
                    preview_pixels[x, y] = (
                        round(max(0, min(255, new_red))),
                        round(max(0, min(255, new_green))),
                        round(max(0, min(255, new_blue))),
                        old_alpha,
                    )
            preview.convert("RGB").save(preview_path)


def worker_loop() -> None:
    while True:
        job_id = job_queue.get()
        try:
            with jobs_lock:
                job = jobs.get(job_id)
                if not job or job.get("status") not in {"queued", "running"}:
                    continue
            run_job(job_id)
        except Exception as exc:
            update_job(job_id, status="failed", stage="failed", error=str(exc))
        finally:
            job_queue.task_done()


def start_worker_once() -> None:
    global worker_started
    if worker_started:
        return
    worker = threading.Thread(target=worker_loop, daemon=True)
    worker.start()
    worker_started = True


def requeue_unfinished_jobs() -> None:
    with jobs_lock:
        pending = sorted(
            [
                dict(item)
                for item in jobs.values()
                if item.get("status") in {"queued", "running"}
            ],
            key=job_sort_key,
        )
        for item in pending:
            job = jobs.get(str(item.get("id")))
            if not job:
                continue
            job["status"] = "queued"
            job["stage"] = "queued"
            job["progress"] = 0
            job["stage_detail"] = "服务重启后重新排队"
            job["updated_at"] = now_ts()
            write_json(status_path(str(job["id"])), job)
    for item in pending:
        job_queue.put(str(item["id"]))


@app.on_event("startup")
def startup() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    EXAMPLE_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    load_jobs()
    requeue_unfinished_jobs()
    start_worker_once()


def run_job(job_id: str) -> None:
    data = jobs[job_id]
    params = data["params"]
    root = job_dir(job_id)
    input_png = root / "input.png"
    infer_out = root / "difflocks"
    blend_work = root / "blend_work"
    result_blend = root / "result.blend"
    preview_dir = root / "preview"

    update_job(
        job_id,
        status="running",
        stage="difflocks_inference",
        progress=5,
        stage_detail="准备生成",
        started_at=now_ts(),
    )
    if INPROCESS_INFERENCE:
        def infer_once():
            from runner import run_inference

            return run_inference(
                DIFFLOCKS_REPO,
                input_png,
                infer_out,
                seed=params["seed"],
                steps=params["steps"],
                cfg=params["cfg"],
                crop=params["crop"],
                upsample=params["upsample"],
                chunks=params.get("decode_chunks", 10),
            )

        run_callable_logged(
            job_id,
            "in-process DiffLocks inference",
            infer_once,
            progress_parser=parse_difflocks_progress,
        )
    else:
        run_logged(
            job_id,
            [
                DIFFLOCKS_PYTHON,
                str(APP_DIR / "runner.py"),
                "--repo",
                str(DIFFLOCKS_REPO),
                "--img-path",
                str(input_png),
                "--out-path",
                str(infer_out),
                "--seed",
                str(params["seed"]),
                "--steps",
                str(params["steps"]),
                "--cfg",
                str(params["cfg"]),
                "--crop",
                str(params["crop"]),
                "--upsample",
                str(params["upsample"]),
                "--chunks",
                str(params.get("decode_chunks", 10)),
            ],
            cwd=APP_DIR,
            progress_parser=parse_difflocks_progress,
        )

    npz_path = infer_out / "difflocks_output_strands.npz"
    if not npz_path.exists():
        raise RuntimeError("DiffLocks did not create difflocks_output_strands.npz")

    update_job(job_id, stage="blend_export", progress=72, stage_detail="导出 Blender 场景")
    if blend_work.exists():
        shutil.rmtree(blend_work)
    blend_work.mkdir(parents=True, exist_ok=True)
    run_logged(
        job_id,
        [
            BLENDER,
            "-t",
            "8",
            "--background",
            "--python",
            str(DIFFLOCKS_REPO / "inference" / "npz2blender.py"),
            "--",
            "--input_npz",
            str(npz_path),
            "--out_path",
            str(blend_work),
            "--strands_subsample",
            str(params["strand_subsample"]),
            "--vertex_subsample",
            str(params["vertex_subsample"]),
        ],
        cwd=DIFFLOCKS_REPO,
    )

    source_blend = blend_work / "blender_scene.blend"
    if not source_blend.exists():
        raise RuntimeError("Blender export did not create blender_scene.blend")

    update_job(job_id, stage="workbench_preview", progress=88, stage_detail="生成工作台预览")
    preview_dir.mkdir(parents=True, exist_ok=True)
    run_logged(
        job_id,
        [
            BLENDER,
            "--background",
            "--python",
            str(APP_DIR / "blender_post.py"),
            "--",
            "--input-blend",
            str(source_blend),
            "--out-blend",
            str(result_blend),
            "--preview-dir",
            str(preview_dir),
            "--radius",
            str(params["radius"]),
            "--resolution",
            str(params["preview_resolution"]),
        ],
        cwd=APP_DIR,
    )

    if not result_blend.exists():
        raise RuntimeError("Final blend was not created")

    update_job(
        job_id,
        status="done",
        stage="done",
        progress=100,
        stage_detail="完成",
        finished_at=now_ts(),
        outputs={
            "blend": f"/api/jobs/{job_id}/files/result.blend",
            "input": f"/api/jobs/{job_id}/files/input.png",
            "rgb": f"/api/jobs/{job_id}/files/difflocks/rgb.png",
            "previews": {
                view: f"/api/jobs/{job_id}/files/preview/{view}.png"
                for view in ("front", "right", "back", "left")
                if (preview_dir / f"{view}.png").exists()
            },
        },
    )


