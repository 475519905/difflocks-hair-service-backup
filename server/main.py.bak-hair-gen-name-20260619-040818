def job_sort_key(job: dict[str, Any]) -> tuple[float, str]:
    return (float(job.get("created_at") or 0), str(job.get("id") or ""))


def queue_snapshot(job_id: str | None = None) -> dict[str, Any]:
    with jobs_lock:
        values = [dict(item) for item in jobs.values()]
    queued = sorted(
        [item for item in values if item.get("status") == "queued"],
        key=job_sort_key,
    )
    running = sorted(
        [item for item in values if item.get("status") == "running"],
        key=job_sort_key,
    )
    running_count = len(running)
    data: dict[str, Any] = {
        "queued_count": len(queued),
        "running_count": running_count,
        "queue_length": len(queued) + running_count,
    }
    if job_id:
        queued_ids = [str(item.get("id")) for item in queued]
        running_ids = [str(item.get("id")) for item in running]
        if job_id in queued_ids:
            index = queued_ids.index(job_id)
            data.update(
                {
                    "queue_position": index + 1,
                    "jobs_ahead": running_count + index,
                    "is_running": False,
                }
            )
        elif job_id in running_ids:
            data.update({"queue_position": 0, "jobs_ahead": 0, "is_running": True})
    return data


